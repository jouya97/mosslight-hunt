# Optional host-only configuration. Copy to .env (ignored by git), or export keys.
# Existing process environment values take precedence. Never put keys in run folders.
# Offline checks and scripted validation do not require credentials.

# Required only for a paid direct Anthropic launch:
ANTHROPIC_API_KEY=

# Required only for a paid OpenRouter launch (OPEN_ROUTER_KEY is also accepted):
OPENROUTER_API_KEY=

# A paid run exposes web_search and requires one host search provider:
BRAVE_SEARCH_API_KEY=
# Used as the search fallback when Brave is not configured:
OPENAI_API_KEY=
